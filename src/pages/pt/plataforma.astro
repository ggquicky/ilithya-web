---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Features from '../../components/Features.astro';
import RoleBenefits from '../../components/RoleBenefits.astro';
import PilotPlan from '../../components/PilotPlan.astro';
import Footer from '../../components/Footer.astro';
import { getTranslations } from '../../i18n/ui';

const t = getTranslations('pt');
---

<Layout 
  title={t.meta.platform.title}
  description={t.meta.platform.description}
  lang="pt"
>
  <Header lang="pt" />

  <main>
    <!-- Page Intro Header -->
    <section class="page-intro-header">
      <div class="container text-center">
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
          <a href="/pt/">{t.nav.home}</a>
          <span class="bc-sep">/</span>
          <span class="bc-current">{t.nav.platform}</span>
        </nav>
        <span class="section-tag">{t.meta.platform.tag}</span>
        <h1 class="page-intro-title">{t.meta.platform.heading}</h1>
        <p class="page-intro-desc">
          {t.meta.platform.intro}
        </p>
      </div>
    </section>

    <!-- Technical Features Section -->
    <Features lang="pt" />

    <!-- Role Benefits Section -->
    <RoleBenefits lang="pt" />

    <!-- Pilot Callout -->
    <PilotPlan lang="pt" />
  </main>

  <Footer lang="pt" />
</Layout>

<style>
  .page-intro-header {
    padding-top: 4.5rem;
    padding-bottom: 2.5rem;
    background: radial-gradient(ellipse at top, rgba(16, 185, 129, 0.1) 0%, transparent 70%);
    position: relative;
  }

  .breadcrumb-nav {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-dim);
    margin-bottom: 1.25rem;
  }

  .breadcrumb-nav a {
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .breadcrumb-nav a:hover {
    color: var(--color-primary);
  }

  .bc-sep {
    opacity: 0.4;
  }

  .bc-current {
    color: var(--accent-green);
    font-weight: 600;
  }

  .page-intro-title {
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.15;
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
  }

  .page-intro-desc {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 720px;
    margin-inline: auto;
    line-height: 1.6;
  }

  .text-center {
    text-align: center;
  }
</style>
