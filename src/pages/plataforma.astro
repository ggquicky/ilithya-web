---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Features from '../components/Features.astro';
import RoleBenefits from '../components/RoleBenefits.astro';
import PilotPlan from '../components/PilotPlan.astro';
import Footer from '../components/Footer.astro';
import { getTranslations } from '../i18n/ui';

const t = getTranslations('es');
---

<Layout 
  title={t.meta.platform.title}
  description={t.meta.platform.description}
  keywords={t.meta.platform.keywords}
  lang="es"
>
  <Header lang="es" />

  <main>
    <!-- Page Intro Header -->
    <section class="page-intro-header">
      <div class="container text-center">
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
          <a href="/">Inicio</a>
          <span class="bc-sep">/</span>
          <span class="bc-current">Plataforma & TI</span>
        </nav>
        <span class="section-tag">Arquitectura & Seguridad</span>
        <h1 class="page-intro-title">Infraestructura Ligera. Seguridad Implacable.</h1>
        <p class="page-intro-desc">
          Ilithya Workflow combina un motor de firma y estampa de sellos sobre coordenadas exactas de PDF con aislamiento estricto de base de datos y respaldo en la nube corporativa de su empresa.
        </p>
      </div>
    </section>

    <!-- Technical Features Section -->
    <Features lang="es" />

    <!-- Role Benefits Section -->
    <RoleBenefits lang="es" />

    <!-- Pilot Callout -->
    <PilotPlan lang="es" />
  </main>

  <Footer lang="es" />
</Layout>

<style>
  .page-intro-header {
    padding-top: 4.5rem;
    padding-bottom: 2.5rem;
    background: radial-gradient(ellipse at top, rgba(16, 185, 129, 0.1) 0%, transparent 70%);
    position: relative;
  }

  .breadcrumb-nav {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-dim);
    margin-bottom: 1.25rem;
  }

  .breadcrumb-nav a {
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .breadcrumb-nav a:hover {
    color: var(--color-primary);
  }

  .bc-sep {
    opacity: 0.4;
  }

  .bc-current {
    color: var(--accent-green);
    font-weight: 600;
  }

  .page-intro-title {
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.15;
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
  }

  .page-intro-desc {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 720px;
    margin-inline: auto;
    line-height: 1.6;
  }

  .text-center {
    text-align: center;
  }
</style>
