---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ContactUs from '../components/ContactUs.astro';
import Footer from '../components/Footer.astro';
import { getTranslations } from '../i18n/ui';

const t = getTranslations('es');
---

<Layout 
  title={t.meta.contact.title}
  description={t.meta.contact.description}
  keywords={t.meta.contact.keywords}
  lang="es"
>
  <Header lang="es" />

  <main>
    <!-- Page Intro Header -->
    <section class="page-intro-header">
      <div class="container text-center">
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
          <a href="/">Inicio</a>
          <span class="bc-sep">/</span>
          <span class="bc-current">Contacto</span>
        </nav>
        <span class="section-tag">Canal Directo</span>
        <h1 class="page-intro-title">Hablemos de tus Procesos</h1>
        <p class="page-intro-desc">
          Estamos listos para apoyarle en la digitalización de sus rutas de aprobación. Envíenos sus datos y un especialista corporativo se comunicará en menos de 2 horas.
        </p>
      </div>
    </section>

    <!-- Full Contact Us Panel -->
    <ContactUs lang="es" />
  </main>

  <Footer lang="es" />
</Layout>

<style>
  .page-intro-header {
    padding-top: 4.5rem;
    padding-bottom: 2.5rem;
    background: radial-gradient(ellipse at top, rgba(19, 127, 236, 0.12) 0%, transparent 70%);
    position: relative;
  }

  .breadcrumb-nav {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-dim);
    margin-bottom: 1.25rem;
  }

  .breadcrumb-nav a {
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .breadcrumb-nav a:hover {
    color: var(--color-primary);
  }

  .bc-sep {
    opacity: 0.4;
  }

  .bc-current {
    color: var(--color-primary);
    font-weight: 600;
  }

  .page-intro-title {
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.15;
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
  }

  .page-intro-desc {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 720px;
    margin-inline: auto;
    line-height: 1.6;
  }

  .text-center {
    text-align: center;
  }
</style>
