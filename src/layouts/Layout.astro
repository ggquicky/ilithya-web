---
import '../styles/global.css';
import PilotModal from '../components/PilotModal.astro';
import { getLocalizedPath, languages, translations, type Language } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  keywords?: string;
  lang?: Language;
}

const lang = (Astro.props.lang || Astro.currentLocale || 'es') as Language;
const t = translations[lang] || translations.es;

const title = Astro.props.title || t.meta.home.title;
const description = Astro.props.description || t.meta.home.description;
const keywords = Astro.props.keywords || t.meta.home.keywords;
const ogImage = Astro.props.ogImage || "/brand/darkLogo.png";

// Canonical, Hreflang and OpenGraph URLs
const siteUrl = Astro.site ?? 'https://ilithya.app';
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, siteUrl);
const ogImageURL = new URL(ogImage, siteUrl);

const localeMap: Record<Language, string> = {
  es: 'es_LA',
  en: 'en_US',
  it: 'it_IT',
  pt: 'pt_BR'
};

const altLangs = (Object.keys(languages) as Language[]).map(code => ({
  code,
  url: new URL(getLocalizedPath(currentPath, code), siteUrl)
}));

// Build BreadcrumbList
const isHomePage = currentPath === '/' || currentPath === `/${lang}` || currentPath === `/${lang}/`;
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": t.nav.home || "Inicio",
    "item": new URL(getLocalizedPath('/', lang), siteUrl).toString()
  }
];

if (!isHomePage) {
  const pageTitleClean = title.split('•')[0].split('|')[0].trim();
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": 2,
    "name": pageTitleClean,
    "item": canonicalURL.toString()
  });
}

// Structured Data (JSON-LD) for Google Rich Snippets
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://ilithya.app/#organization",
      "name": "Ilithya Workflow",
      "url": "https://ilithya.app",
      "logo": {
        "@type": "ImageObject",
        "url": "https://ilithya.app/brand/darkLogo.png",
        "width": "512",
        "height": "512"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "jlmoralesm08@gmail.com",
        "contactType": "customer service",
        "availableLanguage": ["Spanish", "English", "Italian", "Portuguese"]
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://ilithya.app/#website",
      "url": "https://ilithya.app",
      "name": "Ilithya Workflow",
      "description": description,
      "inLanguage": lang,
      "publisher": {
        "@id": "https://ilithya.app/#organization"
      }
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalURL}#webpage`,
      "url": canonicalURL.toString(),
      "name": title,
      "description": description,
      "inLanguage": lang,
      "isPartOf": {
        "@id": "https://ilithya.app/#website"
      },
      "breadcrumb": {
        "@id": `${canonicalURL}#breadcrumb`
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalURL}#breadcrumb`,
      "itemListElement": breadcrumbItems
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://ilithya.app/#software",
      "name": "Ilithya Workflow",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "All modern web browsers",
      "description": description,
      "url": "https://ilithya.app",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Favicon & App Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon.png" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Ilithya Workflow Inc." />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Canonical & Alternate Hreflang URLs -->
    <link rel="canonical" href={canonicalURL} />
    {altLangs.map(alt => (
      <link rel="alternate" hreflang={alt.code} href={alt.url} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(getLocalizedPath(currentPath, 'es'), siteUrl)} />

    <!-- Search Engine Directives -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Ilithya Workflow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={localeMap[lang] || 'es_LA'} />
    {(Object.keys(localeMap) as Language[])
      .filter(l => l !== lang)
      .map(l => (
        <meta property="og:locale:alternate" content={localeMap[l]} />
      ))
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />

    <!-- Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

    <!-- Theme Initialization (Inline to prevent FOUC) -->
    <script is:inline>
      (function() {
        try {
          var saved = localStorage.getItem('flowpilot_theme') || localStorage.getItem('theme');
          var isLight = saved === 'light';
          if (isLight) {
            document.documentElement.classList.add('light');
            document.documentElement.classList.remove('dark');
            document.documentElement.setAttribute('data-theme', 'light');
          } else {
            document.documentElement.classList.add('dark');
            document.documentElement.classList.remove('light');
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
    <PilotModal lang={lang} />

    <script is:inline>
      (function() {
        document.addEventListener('click', function(e) {
          var btn = e.target && e.target.closest && e.target.closest('.theme-toggle');
          if (!btn) return;
          e.preventDefault();
          var root = document.documentElement;
          var isCurrentlyLight = root.classList.contains('light');
          var targetTheme = isCurrentlyLight ? 'dark' : 'light';

          root.classList.add('theme-transitioning');

          if (targetTheme === 'light') {
            root.classList.add('light');
            root.classList.remove('dark');
            root.setAttribute('data-theme', 'light');
          } else {
            root.classList.add('dark');
            root.classList.remove('light');
            root.setAttribute('data-theme', 'dark');
          }

          try {
            localStorage.setItem('flowpilot_theme', targetTheme);
            localStorage.setItem('theme', targetTheme);
          } catch (err) {}

          setTimeout(function() {
            root.classList.remove('theme-transitioning');
          }, 300);
        });

        // Cross-tab synchronization
        window.addEventListener('storage', function(e) {
          if (e.key === 'flowpilot_theme' || e.key === 'theme') {
            var newTheme = e.newValue;
            var root = document.documentElement;
            if (newTheme === 'light') {
              root.classList.add('light');
              root.classList.remove('dark');
              root.setAttribute('data-theme', 'light');
            } else if (newTheme === 'dark') {
              root.classList.add('dark');
              root.classList.remove('light');
              root.setAttribute('data-theme', 'dark');
            }
          }
        });
      })();
    </script>
  </body>
</html>
