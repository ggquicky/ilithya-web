---
import { getTranslations, type Language } from '../i18n/ui';

interface Props {
  lang?: Language;
}

const { lang = (Astro.currentLocale || 'es') as Language } = Astro.props;
const isEs = lang === 'es';
---

<section class="pilot-section" id="plan-piloto">
  <div class="container">
    <div class="pilot-wrapper">
      <div class="pilot-content">
        <span class="section-tag">{isEs ? 'Propuesta de Colaboración' : 'Collaborative Evaluation'}</span>
        <h2 class="pilot-title">
          {isEs ? 'Evaluemos juntos el impacto en tu operación' : 'Let’s measure the operational impact together'}
        </h2>
        <p class="pilot-desc">
          {isEs 
            ? 'Queremos que experimenten la agilidad de Ilithya con un proceso real de su empresa. Sin costos ocultos, sin instalaciones complejas y con total acompañamiento.' 
            : 'Experience Ilithya’s velocity on a live operational process in your organization. Zero hidden costs, zero software installations, with 1-on-1 engineering guidance.'}
        </p>

        <!-- 3-Phase Timeline -->
        <div class="pilot-steps">
          <div class="pilot-step-item">
            <div class="step-num-badge">1</div>
            <div class="step-body">
              <h3 class="step-heading">{isEs ? 'Selección' : 'Selection'}</h3>
              <p class="step-text">
                {isEs 
                  ? 'Elegimos 1 proceso de compra, viáticos o solicitud representativo de su día a día.' 
                  : 'We select 1 representative purchasing, travel, or personnel workflow from your day-to-day.'}
              </p>
            </div>
          </div>

          <div class="pilot-step-divider"></div>

          <div class="pilot-step-item">
            <div class="step-num-badge">2</div>
            <div class="step-body">
              <h3 class="step-heading">{isEs ? 'Configuración' : 'Configuration'}</h3>
              <p class="step-text">
                {isEs 
                  ? 'Acompañamos a su equipo a configurar la ruta, estaciones y reglas de aprobación en horas.' 
                  : 'We pair with your team to configure approval stations, rules, and PDF templates in hours.'}
              </p>
            </div>
          </div>

          <div class="pilot-step-divider"></div>

          <div class="pilot-step-item">
            <div class="step-num-badge">3</div>
            <div class="step-body">
              <h3 class="step-heading">{isEs ? 'Evaluación' : 'Evaluation'}</h3>
              <p class="step-text">
                {isEs 
                  ? 'Al finalizar el período, revisamos juntos los tiempos ahorrados y la experiencia de sus usuarios.' 
                  : 'At the conclusion of the evaluation, we review the turnaround hours saved and user satisfaction.'}
              </p>
            </div>
          </div>
        </div>

        <!-- Closing Quote Card -->
        <div class="pilot-quote-card">
          <div class="quote-symbol">“</div>
          <p class="quote-body">
            {isEs ? (
              <>Permítannos acompañar a su equipo en esta prueba <strong>sin costo ni compromiso</strong>, para que experimenten de primera mano cómo las aprobaciones pueden fluir a tiempo y sin desgaste.</>
            ) : (
              <>Allow us to guide your team through this evaluation <strong>with zero cost or commitment</strong>, experiencing firsthand how enterprise approvals flow on time and without friction.</>
            )}
          </p>
        </div>

        <!-- Call to action button -->
        <div class="pilot-actions">
          <button class="btn btn-primary btn-lg" data-open-modal="pilot" id="pilot-cta-btn">
            <span>{isEs ? 'Solicitar Plan de Prueba (15 a 20 Días)' : 'Request Guided Pilot Trial (15 to 20 Days)'}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
          <span class="pilot-guarantee">{isEs ? '✓ Acompañamiento técnico 1-a-1 incluido' : '✓ 1-on-1 technical onboarding included'}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pilot-section {
    padding-block: 6rem;
    position: relative;
    background: var(--bg-main);
  }

  .pilot-wrapper {
    background: linear-gradient(145deg, var(--bg-surface-elevated) 0%, var(--bg-surface) 100%);
    border: 1px solid var(--border-glow);
    border-radius: var(--radius-xl);
    padding: clamp(2.5rem, 5vw, 4.5rem);
    position: relative;
    overflow: hidden;
    box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.6), 0 0 40px -10px rgba(19, 127, 236, 0.2);
  }

  .pilot-wrapper::after {
    content: '';
    position: absolute;
    bottom: -150px;
    right: -100px;
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, rgba(19, 127, 236, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .pilot-content {
    max-width: 900px;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pilot-title {
    font-size: clamp(2rem, 4vw, 2.85rem);
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.2;
    margin-bottom: 1.25rem;
  }

  .pilot-desc {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 680px;
    line-height: 1.6;
    margin-bottom: 3.5rem;
  }

  /* 3 Steps */
  .pilot-steps {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    margin-bottom: 3.5rem;
    text-align: left;
  }

  .pilot-step-item {
    flex: 1;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    backdrop-filter: blur(8px);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .pilot-step-item:hover {
    transform: translateY(-2px);
    border-color: rgba(96, 165, 250, 0.4);
  }

  .step-num-badge {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 12px rgba(19, 127, 236, 0.4);
  }

  .step-heading {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.35rem;
  }

  .step-text {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  .pilot-step-divider {
    display: none;
  }

  /* Quote Card */
  .pilot-quote-card {
    background: rgba(19, 127, 236, 0.08);
    border: 1px solid rgba(19, 127, 236, 0.25);
    border-radius: var(--radius-lg);
    padding: 1.75rem 2rem;
    max-width: 760px;
    margin-bottom: 3rem;
    position: relative;
    text-align: center;
  }

  .quote-symbol {
    font-family: Georgia, serif;
    font-size: 3rem;
    line-height: 1;
    color: var(--color-primary);
    margin-bottom: -0.5rem;
  }

  .quote-body {
    font-size: 1.1rem;
    color: #e2e8f0;
    line-height: 1.6;
    font-style: italic;
  }

  .quote-body strong {
    color: #ffffff;
    font-weight: 700;
    font-style: normal;
  }

  /* Actions */
  .pilot-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .btn-lg {
    padding: 1rem 2.25rem;
    font-size: 1.05rem;
  }

  .pilot-guarantee {
    font-size: 0.85rem;
    color: var(--accent-green);
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .pilot-steps {
      flex-direction: column;
    }

    .pilot-step-item {
      width: 100%;
    }
  }
</style>
