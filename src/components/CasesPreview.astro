---
import { getTranslations, getLocalizedPath, type Language } from '../i18n/ui';

interface Props {
  lang?: Language;
}

const { lang = (Astro.currentLocale || 'es') as Language } = Astro.props;
const t = getTranslations(lang);
const casesBaseHref = getLocalizedPath('/casos-de-uso', lang);

const caseIcons = [
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>`
];

const cases = t.casesPreview.cases.map((c, i) => ({
  ...c,
  icon: caseIcons[i % caseIcons.length]
}));
const labels = {
  es: {
    viewStations: 'Ver flujo y estaciones',
    exploreAll: 'Explorar los 5 Flujos Detallados Paso a Paso',
    requestPilot: 'Solicitar Plan Piloto (1 Mes)'
  },
  en: {
    viewStations: 'View workflow & stations',
    exploreAll: 'Explore All 5 Workflows Step-by-Step',
    requestPilot: 'Request Pilot Plan (1 Month)'
  },
  it: {
    viewStations: 'Vedi flusso e stazioni',
    exploreAll: 'Esplora Tutti i 5 Flussi Passo dopo Passo',
    requestPilot: 'Richiedi Piano Pilota (1 Mese)'
  },
  pt: {
    viewStations: 'Ver fluxo e estações',
    exploreAll: 'Explorar Todos os 5 Fluxos Passo a Passo',
    requestPilot: 'Solicitar Plano Piloto (1 Mês)'
  }
}[lang] || {
  viewStations: 'Ver flujo y estaciones',
  exploreAll: 'Explorar los 5 Flujos Detallados Paso a Paso',
  requestPilot: 'Solicitar Plan Piloto (1 Mes)'
};
---

<section class="cases-preview-section" id="casos-preview">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-tag">{t.casesPreview.tag}</span>
      <h2 class="section-title">{t.casesPreview.title}</h2>
      <p class="section-desc">
        {t.casesPreview.desc}
      </p>
    </div>

    <div class="cases-preview-grid">
      {cases.map((c) => (
        <a href={`${casesBaseHref}#${c.caseSlug}`} class="preview-case-card">
          <div class="card-top">
            <div class="card-icon" set:html={c.icon}></div>
            <span class="card-sla">SLA {c.sla}</span>
          </div>
          <div class="card-meta">
            <span class="card-code">{c.code}</span>
            <span class="card-tag">{c.tag}</span>
          </div>
          <h3 class="card-title">{c.title}</h3>
          <p class="card-desc">{c.desc}</p>
          <div class="card-link">
            <span>{labels.viewStations}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      ))}
    </div>

    <!-- CTA Row -->
    <div class="preview-cta-row">
      <a href={casesBaseHref} class="btn btn-secondary btn-lg">
        <span>{labels.exploreAll}</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <button class="btn btn-primary btn-lg" data-open-modal="pilot">
        <span>{labels.requestPilot}</span>
      </button>
    </div>
  </div>
</section>

<style>
  .cases-preview-section {
    padding-block: 5.5rem;
    position: relative;
    background: var(--bg-main);
  }

  .cases-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-top: 3.5rem;
    margin-bottom: 3.5rem;
  }

  .preview-case-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease, box-shadow 0.25s ease;
    position: relative;
    overflow: hidden;
  }

  .preview-case-card:hover {
    transform: translateY(-4px);
    border-color: rgba(19, 127, 236, 0.5);
    box-shadow: 0 12px 30px -8px rgba(19, 127, 236, 0.25);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .card-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--color-primary-light);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(19, 127, 236, 0.3);
  }

  .card-sla {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-amber);
    background: var(--accent-amber-bg);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.65rem;
  }

  .card-code {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.05em;
  }

  .card-tag {
    font-size: 0.7rem;
    color: var(--text-dim);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
    line-height: 1.3;
    margin-bottom: 0.65rem;
  }

  .card-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 1.5rem;
  }

  .card-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-top: auto;
    transition: transform 0.2s ease;
  }

  .preview-case-card:hover .card-link {
    transform: translateX(4px);
  }

  .preview-cta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    padding-top: 1rem;
  }

  @media (max-width: 640px) {
    .preview-cta-row {
      flex-direction: column;
      width: 100%;
    }

    .preview-cta-row .btn {
      width: 100%;
    }
  }
</style>
