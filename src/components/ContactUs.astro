---

<section class="contact-section" id="contacto">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-tag">{c.tag}</span>
      <h2 class="section-title">{c.title}</h2>
      <p class="section-desc">{c.desc}</p>
    </div>

    <div class="contact-wrapper">
      <!-- Contact Info & Highlights -->
      <div class="contact-info-panel">
        <div class="info-card">
          <div class="info-badge">
            <span class="dot-live"></span>
            <span>{c.badge}</span>
          </div>
          <h3 class="info-heading">{c.infoHeading}</h3>
          <p class="info-text">{c.infoText}</p>

          <div class="contact-channels">
            <div class="channel-item">
              <div class="channel-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <div class="channel-meta">
                <span class="channel-label">{c.channel1}</span>
                <a href={`mailto:${recipientEmail}`} class="channel-val">{recipientEmail}</a>
              </div>
            </div>

            <div class="channel-item">
              <div class="channel-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
              </div>
              <div class="channel-meta">
                <span class="channel-label">{c.channel2Label}</span>
                <span class="channel-val">{c.channel2Val}</span>
              </div>
            </div>

            <div class="channel-item">
              <div class="channel-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
              </div>
              <div class="channel-meta">
                <span class="channel-label">{c.channel3Label}</span>
                <span class="channel-val">{c.channel3Val}</span>
              </div>
            </div>
          </div>
        </div>

        <div class="quote-card">
          <p class="quote-text">{c.quoteText}</p>
          <div class="quote-author">
            <div class="avatar-placeholder">JM</div>
            <div>
              <div class="author-name">Jorge Morales</div>
              <div class="author-role">{c.quoteAuthorRole}</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Accessible Interactive Contact Form with Direct Email Delivery -->
      <div class="contact-form-panel">
        <form 
          class="contact-form" 
          id="contact-form" 
          method="POST" 
          action={`https://formsubmit.co/ajax/${recipientEmail}`}
        >
          <!-- Anti-spam Honeypot -->
          <div class="visually-hidden">
            <label for="bot-field">{c.honeypot}</label>
            <input type="text" id="bot-field" name="_honey" tabindex="-1" autocomplete="off" />
          </div>

          <!-- FormSubmit Configuration Fields -->
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_subject" id="form-subject" value={c.subject} />

          <div class="form-row">
            <div class="form-group">
              <label for="full-name" class="form-label">{c.fullNameLabel} <span class="required">*</span></label>
              <input 
                type="text" 
                id="full-name" 
                name="name" 
                class="form-input" 
                placeholder={c.fullNamePlaceholder} 
                autocomplete="name" 
                required 
                minlength="2"
              />
            </div>
            <div class="form-group">
              <label for="work-email" class="form-label">{c.emailLabel} <span class="required">*</span></label>
              <input 
                type="email" 
                id="work-email" 
                name="email" 
                class="form-input" 
                placeholder={c.emailPlaceholder} 
                autocomplete="email" 
                required 
              />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="company-name" class="form-label">{c.companyLabel} <span class="required">*</span></label>
              <input 
                type="text" 
                id="company-name" 
                name="company" 
                class="form-input" 
                placeholder={c.companyPlaceholder} 
                autocomplete="organization" 
                required 
              />
            </div>
            <div class="form-group">
              <label for="process-select" class="form-label">{c.processLabel}</label>
              <div class="select-wrapper">
                <select id="process-select" name="proceso_a_evaluar" class="form-select">
                  {c.processOptions.map((opt) => (
                    <option value={opt.value}>{opt.label}</option>
                  ))}
                </select>
                <div class="select-arrow">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </div>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label for="message" class="form-label">{c.messageLabel}</label>
            <textarea 
              id="message" 
              name="message" 
              class="form-textarea" 
              rows="4" 
              placeholder={c.messagePlaceholder}
            ></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-submit" id="submit-btn">
            <span id="btn-text">{c.submitBtn}</span>
            <svg id="btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>

          <p class="form-disclaimer">
            {c.disclaimer}
          </p>

          <!-- Success Alert Banner -->
          <div class="form-alert success" id="form-success" hidden role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <div>
              <strong>{c.successTitle}</strong>
              <p>{c.successDesc}</p>
            </div>
          </div>

          <!-- Activation Required Alert Banner -->
          <div class="form-alert info" id="form-activation" hidden role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <div>
              <strong>{c.activationTitle}</strong>
              <p>{c.activationDesc}</p>
            </div>
          </div>

          <!-- Error Alert Banner -->
          <div class="form-alert error" id="form-error" hidden role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <div>
              <strong>{c.errorTitle}</strong>
              <p>{c.errorDescPart1}<a href={`mailto:${recipientEmail}`} class="underline-link">{recipientEmail}</a>.</p>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('btn-text');
  const btnIcon = document.getElementById('btn-icon');
  const successBanner = document.getElementById('form-success');
  const activationBanner = document.getElementById('form-activation');
  const errorBanner = document.getElementById('form-error');
  const honeypot = document.getElementById('bot-field') as HTMLInputElement | null;
  const subjectInput = document.getElementById('form-subject') as HTMLInputElement | null;

  if (form && submitBtn && btnText) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Anti-spam honeypot defense
      if (honeypot && honeypot.value.trim() !== '') {
        return; // Bot detected, silent reject
      }

      const formData = new FormData(form);
      const name = (formData.get('name') as string)?.trim() || 'Prospect';
      const company = (formData.get('company') as string)?.trim() || 'Enterprise';
      const email = (formData.get('email') as string)?.trim() || '';

      // Set dynamic subject & reply-to headers
      if (subjectInput) {
        subjectInput.value = `[Ilithya Lead] ${name} from ${company}`;
      }
      formData.set('_subject', `[Ilithya Lead] ${name} from ${company}`);
      formData.set('_replyto', email);

      // Reset all banners before submission
      if (errorBanner) errorBanner.hidden = true;
      if (successBanner) successBanner.hidden = true;
      if (activationBanner) activationBanner.hidden = true;

      // Loading state
      submitBtn.setAttribute('disabled', 'true');
      btnText.textContent = 'Sending Message...';
      if (btnIcon) btnIcon.style.display = 'none';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
          },
          body: formData,
        });

        const data = await response.json().catch(() => null);

        // Check for first-time activation message in payload
        if (data && typeof data.message === 'string' && data.message.toLowerCase().includes('activat')) {
          btnText.textContent = 'Activation Required';
          if (errorBanner) errorBanner.hidden = true;
          if (successBanner) successBanner.hidden = true;
          if (activationBanner) activationBanner.hidden = false;
          form.reset();
          return;
        }

        if (response.ok && (!data || data.success === 'true' || data.success === true)) {
          btnText.textContent = 'Sent Successfully!';
          if (errorBanner) errorBanner.hidden = true;
          if (activationBanner) activationBanner.hidden = true;
          if (successBanner) successBanner.hidden = false;
          form.reset();
        } else {
          throw new Error(data?.message || 'Submission error');
        }
      } catch (err: any) {
        console.error('Contact form submission response:', err);
        const errMsg = String(err?.message || '').toLowerCase();
        
        if (errMsg.includes('activat')) {
          btnText.textContent = 'Activation Sent';
          if (errorBanner) errorBanner.hidden = true;
          if (successBanner) successBanner.hidden = true;
          if (activationBanner) activationBanner.hidden = false;
          form.reset();
        } else {
          if (successBanner) successBanner.hidden = true;
          if (activationBanner) activationBanner.hidden = true;
          if (errorBanner) errorBanner.hidden = false;
        }
      } finally {
        submitBtn.removeAttribute('disabled');
        setTimeout(() => {
          btnText.textContent = 'Submit Request';
          if (btnIcon) btnIcon.style.display = 'inline';
        }, 5000);
      }
    });
  }
</script>

<style>
  .contact-section {
    padding-block: 6rem;
    position: relative;
    background: var(--bg-main);
    border-top: 1px solid var(--border-color);
  }

  .text-center {
    text-align: center;
  }

  .section-header {
    margin-bottom: 4rem;
  }

  .contact-wrapper {
