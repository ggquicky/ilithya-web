---
import { getTranslations, type Language } from '../i18n/ui';

interface Props {
  recipientEmail?: string;
  lang?: Language;
}

const { 
  recipientEmail = 'jlmoralesm08@gmail.com',
  lang = (Astro.currentLocale || 'es') as Language 
} = Astro.props;

const isEs = lang === 'es';
---

<section class="contact-section" id="contacto">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-tag">{isEs ? 'Acceso Directo' : 'Direct Access'}</span>
      <h2 class="section-title">
        {isEs ? '¿Listo para agilizar las aprobaciones de tu equipo?' : 'Ready to accelerate your team’s approvals?'}
      </h2>
      <p class="section-desc">
        {isEs 
          ? 'Conéctese con nuestro equipo para iniciar su Plan de Prueba de 15 a 20 días sin costo ni compromiso, o para resolver dudas sobre seguridad y configuración.' 
          : 'Connect with our engineering team to start your 15 to 20-day pilot trial at zero cost, or discuss architecture and security.'}
      </p>
    </div>

    <div class="contact-wrapper">
      <!-- Contact Info & Highlights -->
      <div class="contact-info-panel">
        <div class="info-card">
          <div class="info-badge">
            <span class="dot-live"></span>
            <span>{isEs ? 'Mesa Corporativa' : 'Enterprise Desk'}</span>
          </div>
          <h3 class="info-heading">
            {isEs ? 'Hable con un Especialista de Ilithya Workflow' : 'Speak with an Ilithya Workflow Specialist'}
          </h3>
          <p class="info-text">
            {isEs 
              ? 'Le ayudamos a modelar su primera ruta de aprobación, definir estaciones y activar recordatorios automáticos en minutos.' 
              : 'We will help you model your first approval route, configure stations, and activate smart reminders in minutes.'}
          </p>

          <div class="contact-channels">
            <div class="channel-item">
              <div class="channel-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <div class="channel-meta">
                <span class="channel-label">{isEs ? 'Consultas Directas' : 'Direct Inquiries'}</span>
                <a href={`mailto:${recipientEmail}`} class="channel-val">{recipientEmail}</a>
              </div>
            </div>

            <div class="channel-item">
              <div class="channel-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
              </div>
              <div class="channel-meta">
                <span class="channel-label">{isEs ? 'Seguridad y Cumplimiento' : 'Security & Compliance'}</span>
                <span class="channel-val">{isEs ? 'Aislamiento RLS & Auditoría Criptográfica' : 'RLS Isolation & Cryptographic Audits'}</span>
              </div>
            </div>

            <div class="channel-item">
              <div class="channel-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
              </div>
              <div class="channel-meta">
                <span class="channel-label">{isEs ? 'Respuesta Garantizada' : 'Guaranteed Response'}</span>
                <span class="channel-val">{isEs ? '< 2 horas en días hábiles' : '< 2 hours on business days'}</span>
              </div>
            </div>
          </div>
        </div>

        <div class="quote-card">
          <p class="quote-text">
            {isEs 
              ? '"Ilithya Workflow reemplazó semanas de persecución de firmas por correo por aprobaciones ágiles de 4 horas y registros inmutables de auditoría."' 
              : '"Ilithya Workflow replaced weeks of chasing email signatures with 4-hour agile approvals and immutable audit records."'}
          </p>
          <div class="quote-author">
            <div class="avatar-placeholder">JM</div>
            <div>
              <div class="author-name">Jorge Morales</div>
              <div class="author-role">{isEs ? 'Director de Operaciones & Logística' : 'Director of Operations & Logistics'}</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Accessible Interactive Contact Form with Direct Email Delivery -->
      <div class="contact-form-panel">
        <form 
          class="contact-form" 
          id="contact-form" 
          method="POST" 
          action={`https://formsubmit.co/ajax/${recipientEmail}`}
        >
          <!-- Anti-spam Honeypot -->
          <div class="visually-hidden">
            <label for="bot-field">{isEs ? 'No llenar este campo' : 'Do not fill this field'}</label>
            <input type="text" id="bot-field" name="_honey" tabindex="-1" autocomplete="off" />
          </div>

          <!-- FormSubmit Configuration Fields -->
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_subject" id="form-subject" value={isEs ? 'Nueva Solicitud de Plan Piloto Ilithya Workflow' : 'New Ilithya Workflow Pilot Request'} />

          <div class="form-row">
            <div class="form-group">
              <label for="full-name" class="form-label">{isEs ? 'Nombre Completo' : 'Full Name'} <span class="required">*</span></label>
              <input 
                type="text" 
                id="full-name" 
                name="name" 
                class="form-input" 
                placeholder={isEs ? 'Ej. Roberto Gómez' : 'e.g. Robert Gomez'} 
                autocomplete="name" 
                required 
                minlength="2"
              />
            </div>
            <div class="form-group">
              <label for="work-email" class="form-label">{isEs ? 'Correo Corporativo' : 'Corporate Email'} <span class="required">*</span></label>
              <input 
                type="email" 
                id="work-email" 
                name="email" 
                class="form-input" 
                placeholder={isEs ? 'roberto@empresa.com' : 'robert@company.com'} 
                autocomplete="email" 
                required 
              />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="company-name" class="form-label">{isEs ? 'Empresa / Organización' : 'Company / Organization'} <span class="required">*</span></label>
              <input 
                type="text" 
                id="company-name" 
                name="company" 
                class="form-input" 
                placeholder={isEs ? 'Ej. Grupo Industrial S.A.' : 'e.g. Acme Industrial Corp'} 
                autocomplete="organization" 
                required 
              />
            </div>
            <div class="form-group">
              <label for="process-select" class="form-label">{isEs ? 'Proceso que Desea Evaluar' : 'Process You Wish to Evaluate'}</label>
              <div class="select-wrapper">
                <select id="process-select" name="proceso_a_evaluar" class="form-select">
                  <option value="Compra o Pago a Proveedores">{isEs ? 'Compra o Pago a Proveedores (Finanzas)' : 'Vendor Procurement & Payments (Finance)'}</option>
                  <option value="Solicitud y Pago de Viáticos">{isEs ? 'Solicitud y Pago de Viáticos (Movilidad)' : 'Travel Expenses & Per Diems (Mobility)'}</option>
                  <option value="Onboarding y Selección de Candidatos">{isEs ? 'Selección de Candidatos (RRHH)' : 'Candidate Onboarding (HR)'}</option>
                  <option value="Solicitud de Vacaciones">{isEs ? 'Vacaciones / Acción de Personal (RRHH)' : 'Vacations & Leave Requests (HR)'}</option>
                  <option value="Compra de Suministros">{isEs ? 'Compra de Suministros (Servicios Generales)' : 'Facility Supplies & Maintenance (Operations)'}</option>
                  <option value="Otro Flujo Personalizado">{isEs ? 'Otro Flujo Interno Personalizado' : 'Other Custom Enterprise Workflow'}</option>
                </select>
                <div class="select-arrow">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </div>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label for="message" class="form-label">{isEs ? 'Cuéntanos sobre tu flujo de aprobación actual' : 'Tell us about your current approval workflow'}</label>
            <textarea 
              id="message" 
              name="message" 
              class="form-textarea" 
              rows="4" 
              placeholder={isEs ? 'Ej. Tenemos 3 aprobadores para órdenes de compra y queremos probar la reasignación de ausencias y recordatorios automáticos...' : 'e.g. We have 3 approvers for purchase orders and want to test out-of-office delegation and automated SLA alerts...'}
            ></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-submit" id="submit-btn">
            <span id="btn-text">{isEs ? 'Solicitar Plan Piloto (15 a 20 Días)' : 'Request Guided Pilot Trial (15 to 20 Days)'}</span>
            <svg id="btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>

          <p class="form-disclaimer">
            {isEs ? `🔒 Respetamos tu privacidad. Solicitud enviada directamente al equipo directivo (${recipientEmail}).` : `🔒 We respect your privacy. Request dispatched directly to executive leadership (${recipientEmail}).`}
          </p>

          <!-- Success Alert Banner -->
          <div class="form-alert success" id="form-success" hidden role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <div>
              <strong>{isEs ? '¡Gracias por contactar a Ilithya Workflow!' : 'Thank you for contacting Ilithya Workflow!'}</strong>
              <p>{isEs ? 'Su solicitud ha sido enviada con éxito. Un especialista en flujos se comunicará a la brevedad para coordinar la prueba de 15 a 20 días.' : 'Your request has been sent successfully. A solutions specialist will reach out shortly to coordinate your 15 to 20-day evaluation.'}</p>
            </div>
          </div>

          <!-- Activation Required Alert Banner -->
          <div class="form-alert info" id="form-activation" hidden role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <div>
              <strong>{isEs ? `Acción requerida para ${recipientEmail}` : `Action required for ${recipientEmail}`}</strong>
              <p>{isEs ? `Se envió un correo inicial de confirmación a ${recipientEmail}. Por favor revise su bandeja y haga clic en "Activate Form" para habilitar la recepción de leads.` : `An activation email was sent to ${recipientEmail}. Please check your inbox and click "Activate Form" to enable lead routing.`}</p>
            </div>
          </div>

          <!-- Error Alert Banner -->
          <div class="form-alert error" id="form-error" hidden role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <div>
              <strong>{isEs ? 'Error al enviar el mensaje' : 'Error sending message'}</strong>
              <p>{isEs ? `No se pudo enviar en este momento. Por favor escriba directamente a ` : `Could not send at this time. Please write directly to `}<a href={`mailto:${recipientEmail}`} class="underline-link">{recipientEmail}</a>.</p>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('btn-text');
  const btnIcon = document.getElementById('btn-icon');
  const successBanner = document.getElementById('form-success');
  const activationBanner = document.getElementById('form-activation');
  const errorBanner = document.getElementById('form-error');
  const honeypot = document.getElementById('bot-field') as HTMLInputElement | null;
  const subjectInput = document.getElementById('form-subject') as HTMLInputElement | null;

  if (form && submitBtn && btnText) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Anti-spam honeypot defense
      if (honeypot && honeypot.value.trim() !== '') {
        return; // Bot detected, silent reject
      }

      const formData = new FormData(form);
      const name = (formData.get('name') as string)?.trim() || 'Prospect';
      const company = (formData.get('company') as string)?.trim() || 'Enterprise';
      const email = (formData.get('email') as string)?.trim() || '';

      // Set dynamic subject & reply-to headers
      if (subjectInput) {
        subjectInput.value = `[Ilithya Lead] ${name} from ${company}`;
      }
      formData.set('_subject', `[Ilithya Lead] ${name} from ${company}`);
      formData.set('_replyto', email);

      // Reset all banners before submission
      if (errorBanner) errorBanner.hidden = true;
      if (successBanner) successBanner.hidden = true;
      if (activationBanner) activationBanner.hidden = true;

      // Loading state
      submitBtn.setAttribute('disabled', 'true');
      btnText.textContent = 'Sending Message...';
      if (btnIcon) btnIcon.style.display = 'none';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
          },
          body: formData,
        });

        const data = await response.json().catch(() => null);

        // Check for first-time activation message in payload
        if (data && typeof data.message === 'string' && data.message.toLowerCase().includes('activat')) {
          btnText.textContent = 'Activation Required';
          if (errorBanner) errorBanner.hidden = true;
          if (successBanner) successBanner.hidden = true;
          if (activationBanner) activationBanner.hidden = false;
          form.reset();
          return;
        }

        if (response.ok && (!data || data.success === 'true' || data.success === true)) {
          btnText.textContent = 'Sent Successfully!';
          if (errorBanner) errorBanner.hidden = true;
          if (activationBanner) activationBanner.hidden = true;
          if (successBanner) successBanner.hidden = false;
          form.reset();
        } else {
          throw new Error(data?.message || 'Submission error');
        }
      } catch (err: any) {
        console.error('Contact form submission response:', err);
        const errMsg = String(err?.message || '').toLowerCase();
        
        if (errMsg.includes('activat')) {
          btnText.textContent = 'Activation Sent';
          if (errorBanner) errorBanner.hidden = true;
          if (successBanner) successBanner.hidden = true;
          if (activationBanner) activationBanner.hidden = false;
          form.reset();
        } else {
          if (successBanner) successBanner.hidden = true;
          if (activationBanner) activationBanner.hidden = true;
          if (errorBanner) errorBanner.hidden = false;
        }
      } finally {
        submitBtn.removeAttribute('disabled');
        setTimeout(() => {
          btnText.textContent = 'Submit Request';
          if (btnIcon) btnIcon.style.display = 'inline';
        }, 5000);
      }
    });
  }
</script>

<style>
  .contact-section {
    padding-block: 6rem;
    position: relative;
    background: var(--bg-main);
    border-top: 1px solid var(--border-color);
  }

  .text-center {
    text-align: center;
  }

  .section-header {
    margin-bottom: 4rem;
  }

  .contact-wrapper {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 3rem;
    align-items: flex-start;
  }

  /* Info Panel */
  .contact-info-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-card {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: 2.25rem;
  }

  .info-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-green);
    background: var(--accent-green-bg);
    border: 1px solid rgba(16, 185, 129, 0.25);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    margin-bottom: 1.25rem;
  }

  .dot-live {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-green);
    box-shadow: 0 0 8px var(--accent-green);
  }

  .info-heading {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }

  .info-text {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .channel-item {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .channel-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--color-primary-light);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid rgba(19, 127, 236, 0.2);
  }

  .channel-meta {
    display: flex;
    flex-direction: column;
  }

  .channel-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-dim);
  }

  .channel-val {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-main);
  }

  a.channel-val:hover {
    color: var(--color-primary);
  }

  /* Quote Card */
  .quote-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
  }

  .quote-text {
    font-size: 0.9375rem;
    font-style: italic;
    color: var(--text-main);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .quote-author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .avatar-placeholder {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, #137fec, #6366f1);
    color: #ffffff;
    font-size: 0.8125rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .author-name {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .author-role {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Contact Form Panel */
  .contact-form-panel {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: 2.75rem;
    box-shadow: var(--shadow-lg);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .visually-hidden {
    position: absolute;
    clip-path: inset(50%);
    overflow: hidden;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    white-space: nowrap;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .required {
    color: var(--accent-red);
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    font-family: inherit;
    font-size: 0.9375rem;
    color: var(--text-main);
    background: var(--bg-main);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    min-height: 46px;
  }

  .form-input::placeholder,
  .form-textarea::placeholder {
    color: var(--text-dim);
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-light);
    outline: none;
  }

  .select-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .form-select {
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    padding-right: 2.5rem;
  }

  .select-arrow {
    position: absolute;
    right: 1rem;
    pointer-events: none;
    color: var(--text-dim);
    display: flex;
  }

  .form-textarea {
    resize: vertical;
    min-height: 110px;
  }

  .btn-submit {
    width: 100%;
    padding: 0.95rem;
    font-size: 1rem;
  }

  .form-disclaimer {
    font-size: 0.75rem;
    color: var(--text-dim);
    text-align: center;
    line-height: 1.4;
  }

  .form-alert[hidden] { display: none !important; }
  .form-alert {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    animation: fadeIn 0.3s ease;
  }

  .form-alert.success {
    background: var(--accent-green-bg);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: var(--accent-green);
  }

  .form-alert.info {
    background: rgba(19, 127, 236, 0.15);
    border: 1px solid rgba(19, 127, 236, 0.4);
    color: #38bdf8;
  }

  .form-alert.error {
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: var(--accent-red);
  }

  .form-alert strong {
    display: block;
    font-weight: 700;
    margin-bottom: 0.15rem;
  }

  .form-alert p {
    color: var(--text-main);
    font-size: 0.8125rem;
    margin: 0;
  }

  .underline-link {
    color: var(--color-primary);
    text-decoration: underline;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 900px) {
    .contact-wrapper {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
    }

    .contact-form-panel {
      padding: 1.5rem;
    }
  }
</style>
