---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSelector from './LanguageSelector.astro';
import { getTranslations, getLocalizedPath, type Language } from '../i18n/ui';

interface Props {
  appUrl?: string;
  lang?: Language;
}

const { 
  appUrl = 'https://home.ilithya.app/',
  lang = (Astro.currentLocale || 'es') as Language
} = Astro.props;

const t = getTranslations(lang);
const homeHref = getLocalizedPath('/', lang);
const casesHref = getLocalizedPath('/casos-de-uso', lang);
const platformHref = getLocalizedPath('/plataforma', lang);
const pilotHref = getLocalizedPath('/plan-piloto', lang);
const contactHref = getLocalizedPath('/contacto', lang);
---

<header class="site-header">
  <div class="container header-container">
    <a href={homeHref} class="brand-logo" aria-label="Ilithya Workflow Home">
      <img src="/brand/darkLogo.png" alt="Ilithya Workflow" class="brand-logo-img logo-dark" />
      <img src="/brand/lightLogo.png" alt="Ilithya Workflow" class="brand-logo-img logo-light" />
    </a>

    <nav class="nav-links" aria-label={lang === 'es' ? 'Navegación Principal' : 'Main Navigation'}>
      <a href={homeHref} class="nav-item">{t.nav.home}</a>
      <a href={casesHref} class="nav-item">{t.nav.useCases}</a>
      <a href={platformHref} class="nav-item">{t.nav.platform}</a>
      <a href={pilotHref} class="nav-item">{t.nav.pilotPlan}</a>
      <a href={contactHref} class="nav-item">{t.nav.contact}</a>
    </nav>

    <div class="header-actions">
      <LanguageSelector id="desktop-lang-selector" lang={lang} />
      <ThemeToggle id="desktop-theme-toggle" />
      <a href={`${appUrl}/login`} class="btn btn-ghost" id="nav-login">{t.nav.login}</a>
      <button class="btn btn-primary" data-open-modal="pilot" id="nav-cta">
        <span>{t.nav.cta}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
      <button class="mobile-toggle" id="mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <a href={homeHref} class="mobile-nav-item">{t.nav.home}</a>
    <a href={casesHref} class="mobile-nav-item">{t.nav.useCases}</a>
    <a href={platformHref} class="mobile-nav-item">{t.nav.platform}</a>
    <a href={pilotHref} class="mobile-nav-item">{t.nav.pilotPlan}</a>
    <a href={contactHref} class="mobile-nav-item">{t.nav.contact}</a>
    <div class="mobile-theme-row">
      <span class="mobile-theme-label">{t.nav.language}</span>
      <LanguageSelector id="mobile-lang-selector" variant="segmented" lang={lang} />
    </div>
    <div class="mobile-theme-row">
      <span class="mobile-theme-label">{t.nav.theme}</span>
      <ThemeToggle id="mobile-theme-toggle" />
    </div>
    <div class="mobile-menu-actions">
      <a href={`${appUrl}/login`} class="btn btn-secondary w-full">{t.nav.login}</a>
      <button class="btn btn-primary w-full" data-open-modal="pilot">{t.nav.ctaFull}</button>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.hidden = isExpanded;
    });

    const menuLinks = mobileMenu.querySelectorAll('a');
    menuLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.hidden = true;
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-color);
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    user-select: none;
    text-decoration: none;
  }

  .brand-logo-img {
    height: 50px;
    width: auto;
    object-fit: contain;
    display: block;
    transition: transform 0.2s ease, filter 0.2s ease;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.4));
  }

  .logo-dark {
    display: block;
  }

  .logo-light {
    display: none;
  }

  :global(html.light) .logo-dark {
    display: none !important;
  }

  :global(html.light) .logo-light {
    display: block !important;
  }

  .brand-logo:hover .brand-logo-img {
    transform: translateY(-1px);
    filter: drop-shadow(0 3px 12px rgba(16, 185, 129, 0.25));
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-item {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .nav-item:hover {
    color: var(--text-main);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .mobile-toggle {
    display: none;
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    color: var(--text-main);
    padding: 0.5rem;
    cursor: pointer;
  }

  .mobile-menu {
    display: none;
  }

  .mobile-nav-item {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-main);
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .mobile-theme-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--border-color);
  }

  .mobile-theme-label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .mobile-menu-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .w-full {
    width: 100%;
  }

  @media (max-width: 860px) {
    .brand-logo-img {
      height: 44px;
    }

    .nav-links,
    #nav-login,
    #nav-cta {
      display: none;
    }

    .mobile-toggle {
      display: inline-flex;
    }

    .mobile-menu:not([hidden]) {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      border-top: 1px solid var(--border-color);
      background: var(--bg-surface);
      padding: 1.5rem;
    }
  }
</style>
