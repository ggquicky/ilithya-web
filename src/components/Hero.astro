    docSub: 'Workflow: Vendor Procurement • Requester: Charles Mendez (IT) • 3 Attachments (Requisition + Quote + Case)',
    step1Role: 'Requester',
    step1Name: 'Package Uploaded',
    step1Time: 'Today, 09:15 AM',
    step2Role: 'Department Head (IT)',
    step2Name: 'Authorized & Stamped',
    step2Time: 'Today, 11:28 AM',
    step3Role: 'Finance Director',
    step3Name: 'Budget Validation',
    step3Time: 'Assigned to L. Morales',
    step4Role: 'Procurement Dept',
    step4Name: 'Purchase Order',
    step4Time: 'Based on Final PDF',
    auditTitle: 'Live Cryptographic Audit Trail',
    audit1: 'Digital signature and stamp affixed by Department Head (IT) with UTC timestamp.',
    audit2: 'Technical validation approved: 2 supplier quotes compared and budget justified.',
