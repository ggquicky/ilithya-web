    ctaPilot: 'Solicitar Plano Piloto (15 a 20 Dias)',
    ctaCases: 'Explorar Casos de Uso',
    trustSluggish: 'Lembretes & SLAs em Tempo Real',
    trustSignatures: 'Assinaturas & Carimbos Criptográficos',
    trustArchive: 'PDF Consolidado e Auto-Arquivamento',
    liveSync: 'Sincronização em Tempo Real',
    docTitle: 'Requisicao_Compra_Servidores_OC-80492.pdf',
    inReview: 'Em Aprovação',
