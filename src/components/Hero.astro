    docSub: 'Fluxo: Compra a Fornecedores • Solicitante: Carlos Mendes (TI) • 3 Anexos (Requisição + Cotação + Justificativa)',
    step1Role: 'Solicitante',
    step1Name: 'Processo Enviado',
    step1Time: 'Hoje, 09:15',
    step2Role: 'Gestor de Área (TI)',
