---
import { getTranslations, getLocalizedPath, type Language } from '../i18n/ui';

interface Props {
  lang?: Language;
}

const { lang = (Astro.currentLocale || 'es') as Language } = Astro.props;
const t = getTranslations(lang);
const currentYear = new Date().getFullYear();

const homeHref = getLocalizedPath('/', lang);
const casesHref = getLocalizedPath('/casos-de-uso', lang);
const platformHref = getLocalizedPath('/plataforma', lang);
const pilotHref = getLocalizedPath('/plan-piloto', lang);
const contactHref = getLocalizedPath('/contacto', lang);
const privacyHref = getLocalizedPath('/privacidad', lang);
const termsHref = getLocalizedPath('/terminos', lang);
const footerLabels: Record<Language, {
  uptime: string;
  privacy: string;
  terms: string;
  security: string;
}> = {
  es: {
    uptime: 'Sistemas Operativos • 99.98% Disponibilidad',
    privacy: 'Privacidad',
    terms: 'Términos',
    security: 'Seguridad & Cumplimiento'
  },
  en: {
    uptime: 'All Systems Operational • 99.98% Uptime',
    privacy: 'Privacy',
    terms: 'Terms',
    security: 'Security & Compliance'
  },
  it: {
    uptime: 'Tutti i Sistemi Operativi • 99.98% Disponibilità',
    privacy: 'Privacy',
    terms: 'Termini',
    security: 'Sicurezza & Conformità'
  },
  pt: {
    uptime: 'Todos os Sistemas Operacionais • 99.98% Disponibilidade',
    privacy: 'Privacidade',
    terms: 'Termos',
    security: 'Segurança & Conformidade'
  }
};

const fl = footerLabels[lang] || footerLabels.es;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={homeHref} class="brand-logo" aria-label="Ilithya Workflow Home">
          <img src="/brand/darkLogo.png" alt="Ilithya Workflow" class="footer-logo-img logo-dark" />
          <img src="/brand/lightLogo.png" alt="Ilithya Workflow" class="footer-logo-img logo-light" />
        </a>
        <p class="brand-slogan">
          {t.footer.desc}
        </p>
        <div class="system-status">
          <span class="status-pulse"></span>
          <span>{fl.uptime}</span>
        </div>
      </div>

      <div class="footer-grid">
        <div class="footer-col">
          <h4 class="col-title">{t.footer.navHeading}</h4>
          <ul class="col-links">
            <li><a href={homeHref}>{t.nav.home}</a></li>
            <li><a href={casesHref}>{t.nav.useCases}</a></li>
            <li><a href={platformHref}>{t.nav.platform}</a></li>
            <li><a href={pilotHref}>{t.nav.pilotPlan}</a></li>
            <li><a href={contactHref}>{t.nav.contact}</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="col-title">{t.footer.capabilitiesHeading}</h4>
          <ul class="col-links">
            {t.footer.capabilitiesList.map((item) => (
              <li><a href={platformHref}>{item}</a></li>
            ))}
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="col-title">{t.footer.complianceHeading}</h4>
          <ul class="col-links">
            {t.footer.complianceList.map((item) => (
              <li><a href={platformHref}>{item}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        &copy; {currentYear} Ilithya Workflow Inc. {t.footer.rights}
      </p>
      <div class="legal-links">
        <a href={privacyHref}>{fl.privacy}</a>
        <a href={termsHref}>{fl.terms}</a>
        <a href={platformHref}>{fl.security}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-surface);
    border-top: 1px solid var(--border-color);
    padding-top: 5rem;
    padding-bottom: 2.5rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.25fr 2fr;
    gap: 4rem;
    margin-bottom: 4rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    user-select: none;
    text-decoration: none;
  }

  .footer-logo-img {
    height: 48px;
    width: auto;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.4));
  }

  .logo-dark {
    display: block;
  }

  .logo-light {
    display: none;
  }

  :global(html.light) .logo-dark {
    display: none !important;
  }

  :global(html.light) .logo-light {
    display: block !important;
  }

  .brand-slogan {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 320px;
  }

  .system-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-dim);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    background: var(--bg-main);
    border: 1px solid var(--border-color);
    width: fit-content;
  }

  .status-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--accent-green);
    box-shadow: 0 0 6px var(--accent-green);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .col-title {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-main);
    margin-bottom: 1.25rem;
  }

  .col-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .col-links a,
  .footer-btn-link {
    font-size: 0.875rem;
    color: var(--text-muted);
    transition: color 0.15s ease;
    background: transparent;
    border: none;
    padding: 0;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
  }

  .col-links a:hover,
  .footer-btn-link:hover {
    color: var(--color-primary);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
    font-size: 0.8125rem;
    color: var(--text-dim);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .legal-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .legal-links a:hover {
    color: var(--text-main);
  }

  @media (max-width: 860px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
